pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '15'))
    }

    parameters {
        choice(
            name: 'EXECUTION_MODE',
            choices: ['DAEMON_LISTENER', 'MANUAL_BATCH'],
            description: 'DAEMON_LISTENER runs background RabbitMQ consumer. MANUAL_BATCH runs one-off ad-hoc job.'
        )

        activeChoiceHtml(
            name: 'YEAR',
            choiceType: 'ET_FORMATTED_HTML',
            referencedParameters: 'EXECUTION_MODE',
            script: groovyScript(
                fallbackScript: [script: 'return ""', sandbox: true],
                script: [
                    sandbox: true,
                    script: '''
                        if (EXECUTION_MODE.equals("MANUAL_BATCH")) {
                            return """<select name="value" class="setting-input">
                                        <option value="2026">2026</option>
                                        <option value="2025">2025</option>
                                        <option value="2024">2024</option>
                                        <option value="2023">2023</option>
                                      </select>"""
                        } else {
                            return "<i>Not applicable for DAEMON_LISTENER mode</i>"
                        }
                    '''
                ]
            )
        )

        activeChoiceHtml(
            name: 'QUARTER',
            choiceType: 'ET_FORMATTED_HTML',
            referencedParameters: 'EXECUTION_MODE',
            script: groovyScript(
                fallbackScript: [script: 'return ""', sandbox: true],
                script: [
                    sandbox: true,
                    script: '''
                        if (EXECUTION_MODE.equals("MANUAL_BATCH")) {
                            return """<select name="value" class="setting-input">
                                        <option value="1">1</option>
                                        <option value="2">2</option>
                                        <option value="3">3</option>
                                        <option value="4">4</option>
                                      </select>"""
                        } else {
                            return "<i>Not applicable for DAEMON_LISTENER mode</i>"
                        }
                    '''
                ]
            )
        )

        activeChoiceHtml(
            name: 'EXECUTOR',
            choiceType: 'ET_FORMATTED_HTML',
            referencedParameters: 'EXECUTION_MODE',
            script: groovyScript(
                fallbackScript: [script: 'return ""', sandbox: true],
                script: [
                    sandbox: true,
                    script: '''
                        if (EXECUTION_MODE.equals("MANUAL_BATCH")) {
                            return "<input name='value' value='System' class='setting-input' type='text'>"
                        } else {
                            return "<i>Not applicable for DAEMON_LISTENER mode</i>"
                        }
                    '''
                ]
            )
        )

        activeChoiceHtml(
            name: 'FORCE',
            choiceType: 'ET_FORMATTED_HTML',
            referencedParameters: 'EXECUTION_MODE',
            script: groovyScript(
                fallbackScript: [script: 'return ""', sandbox: true],
                script: [
                    sandbox: true,
                    script: '''
                        if (EXECUTION_MODE.equals("MANUAL_BATCH")) {
                            return "<input name='value' type='checkbox' value='true'>"
                        } else {
                            return "<i>Not applicable for DAEMON_LISTENER mode</i>"
                        }
                    '''
                ]
            )
        )

        string(
            name: 'IMAGE_TAG',
            defaultValue: 'latest',
            description: 'Image tag to run (e.g., latest or specific git-sha)'
        )
    }

    environment {
        DOPPLER_TOKEN   = credentials('doppler-personal-token')
        DOPPLER_PROJECT = 'sec-pipeline'
        DOPPLER_CONFIG  = 'prd'
        SSH_CREDS_ID    = 'windows-laptop-ssh'
        IMAGE_BASE_NAME = 'funds-import-job'
        CONTAINER_NAME  = 'funds-import-job-worker'
    }

    stages {
        stage('Fetch Secrets from Doppler Cloud') {
            steps {
                script {
                    def response = sh(
                        script: '''
                            curl -s --request GET \
                              --url "https://api.doppler.com/v3/configs/config/secrets/download?project=${DOPPLER_PROJECT}&config=${DOPPLER_CONFIG}&format=json" \
                              --header "accept: application/json" \
                              --header "authorization: Bearer ${DOPPLER_TOKEN}"
                        ''',
                        returnStdout: true
                    ).trim()

                    def secrets = readJSON text: response

                    env.WINDOWS_HOST                = secrets.WINDOWS_HOST
                    env.WINDOWS_USER                = secrets.WINDOWS_USER
                    env.SPRING_DATASOURCE_URL       = secrets.SPRING_DATASOURCE_URL ?: "jdbc:postgresql://host.docker.internal:5432/funds?sslmode=disable"
                    env.SPRING_DATASOURCE_USERNAME  = secrets.SPRING_DATASOURCE_USERNAME ?: secrets.DB_USER ?: "funds_admin"
                    env.SPRING_DATASOURCE_PASSWORD  = secrets.SPRING_DATASOURCE_PASSWORD ?: secrets.DB_PASSWORD ?: "strong/?12x3401"
                    env.BENCHMARK_REGEX             = secrets.BENCHMARK_REGEX ?: "\\s*\\(reflects no deduction for [^)]*\\)"
                    env.SPRING_RABBITMQ_HOST        = secrets.SPRING_RABBITMQ_HOST ?: secrets.RABBITMQ_HOST ?: "host.docker.internal"
                    env.SPRING_RABBITMQ_PORT        = secrets.SPRING_RABBITMQ_PORT ?: secrets.RABBITMQ_PORT ?: "5672"
                    env.SPRING_RABBITMQ_USERNAME    = secrets.SPRING_RABBITMQ_USERNAME ?: secrets.RABBITMQ_DEFAULT_USER ?: "guest"
                    env.SPRING_RABBITMQ_PASSWORD    = secrets.SPRING_RABBITMQ_PASSWORD ?: secrets.RABBITMQ_DEFAULT_PASSWORD ?: "guest"
                }
            }
        }

        stage('Verify Image Existence on Host') {
            steps {
                script {
                    def targetImage = "${IMAGE_BASE_NAME}:${params.IMAGE_TAG ?: 'latest'}"
                    echo "Checking if ${targetImage} exists on Windows host ${env.WINDOWS_HOST}..."

                    withCredentials([sshUserPrivateKey(credentialsId: env.SSH_CREDS_ID, keyFileVariable: 'SSH_KEY')]) {
                        def imageId = sh(
                            script: """
                                ssh -i "\$SSH_KEY" \
                                    -o StrictHostKeyChecking=no \
                                    -o ConnectTimeout=15 \
                                    ${WINDOWS_USER}@${WINDOWS_HOST} \
                                    "docker images -q ${targetImage}"
                            """,
                            returnStdout: true
                        ).trim()

                        echo "Probe result (Image ID): '${imageId}'"

                        if (!imageId) {
                            error("""
                                ==============================================================================
                                [IMAGE NOT FOUND ERROR]
                                Target image '${targetImage}' does not exist on Windows host ${env.WINDOWS_HOST}.
                                Run deployment pipeline ('funds-import-job-deploy') first to bake the image.
                                ==============================================================================
                            """)
                        }

                        echo "Image '${targetImage}' (ID: ${imageId}) confirmed present on target host."
                    }
                }
            }
        }

        stage('Execute Spring Batch Container') {
            steps {
                script {
                    def targetImage = "${IMAGE_BASE_NAME}:${params.IMAGE_TAG ?: 'latest'}"
                    def execMode = params.EXECUTION_MODE ?: 'DAEMON_LISTENER'

                    withCredentials([sshUserPrivateKey(credentialsId: env.SSH_CREDS_ID, keyFileVariable: 'SSH_KEY')]) {
                        if (execMode == 'DAEMON_LISTENER') {
                            echo "Starting ${targetImage} in persistent DAEMON_LISTENER mode (profile: prod)..."

                            // Safe container cleanup using PowerShell
                            sh """
                                ssh -i "\$SSH_KEY" \
                                    -o StrictHostKeyChecking=no \
                                    -o ConnectTimeout=15 \
                                    ${WINDOWS_USER}@${WINDOWS_HOST} \
                                    "powershell -NoProfile -Command \\\"docker ps -aq -f name=^/${CONTAINER_NAME}\$ | ForEach-Object { docker rm -f \\\$_ }\\\""
                            """

                            // Start background worker with 'prod' profile only (cli runner is excluded)
                            sh """
                                ssh -i "\$SSH_KEY" \
                                    -o StrictHostKeyChecking=no \
                                    -o ConnectTimeout=15 \
                                    ${WINDOWS_USER}@${WINDOWS_HOST} \
                                    "docker run -d \
                                        --name ${CONTAINER_NAME} \
                                        --restart unless-stopped \
                                        --add-host=host.docker.internal:host-gateway \
                                        -e SPRING_PROFILES_ACTIVE=prod \
                                        -e SPRING_DATASOURCE_URL=\\\"${SPRING_DATASOURCE_URL}\\\" \
                                        -e SPRING_DATASOURCE_USERNAME=\\\"${SPRING_DATASOURCE_USERNAME}\\\" \
                                        -e SPRING_DATASOURCE_PASSWORD=\\\"${SPRING_DATASOURCE_PASSWORD}\\\" \
                                        -e BENCHMARK_REGEX=\\\"${BENCHMARK_REGEX}\\\" \
                                        -e SPRING_RABBITMQ_HOST=\\\"${SPRING_RABBITMQ_HOST}\\\" \
                                        -e SPRING_RABBITMQ_PORT=\\\"${SPRING_RABBITMQ_PORT}\\\" \
                                        -e SPRING_RABBITMQ_USERNAME=\\\"${SPRING_RABBITMQ_USERNAME}\\\" \
                                        -e SPRING_RABBITMQ_PASSWORD=\\\"${SPRING_RABBITMQ_PASSWORD}\\\" \
                                        -e JAVA_OPTS='-Xms256m -Xmx1024m' \
                                        ${targetImage}"
                            """
                        } else {
                            def isForce = (params.FORCE == 'true' || params.FORCE == true)
                            def year = params.YEAR ?: '2026'
                            def quarter = params.QUARTER ?: '1'
                            def executor = params.EXECUTOR ?: 'System'

                            echo "Executing ${targetImage} in MANUAL_BATCH mode (profiles: prod,cli) for ${year} Q${quarter} (Force=${isForce})..."

                            // Activate both 'prod' and 'cli' profiles for ad-hoc execution
                            sh """
                                ssh -i "\$SSH_KEY" \
                                    -o StrictHostKeyChecking=no \
                                    -o ConnectTimeout=15 \
                                    ${WINDOWS_USER}@${WINDOWS_HOST} \
                                    "docker run --rm \
                                        --add-host=host.docker.internal:host-gateway \
                                        -e SPRING_PROFILES_ACTIVE=prod,cli \
                                        -e SPRING_DATASOURCE_URL=\\\"${SPRING_DATASOURCE_URL}\\\" \
                                        -e SPRING_DATASOURCE_USERNAME=\\\"${SPRING_DATASOURCE_USERNAME}\\\" \
                                        -e SPRING_DATASOURCE_PASSWORD=\\\"${SPRING_DATASOURCE_PASSWORD}\\\" \
                                        -e BENCHMARK_REGEX=\\\"${BENCHMARK_REGEX}\\\" \
                                        -e YEAR=\\\"${year}\\\" \
                                        -e QUARTER=\\\"${quarter}\\\" \
                                        -e EXECUTOR=\\\"${executor}\\\" \
                                        -e FORCE=\\\"${isForce}\\\" \
                                        -e JAVA_OPTS='-Xms256m -Xmx1024m' \
                                        ${targetImage}"
                            """
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            script {
                def execMode = params.EXECUTION_MODE ?: 'DAEMON_LISTENER'
                if (execMode == 'DAEMON_LISTENER') {
                    echo "Funds Import Job daemon is active and listening on RabbitMQ on ${env.WINDOWS_HOST}."
                } else {
                    echo "Funds Import Job manual execution completed successfully for Year: ${params.YEAR}, Quarter: ${params.QUARTER}."
                }
            }
        }
        failure {
            echo "Funds Import Job run failed. Inspect the logs above."
        }
    }
}