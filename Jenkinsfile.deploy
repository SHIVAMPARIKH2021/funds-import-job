pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '15'))
    }

    parameters {
        booleanParam(name: 'SKIP_TESTS', defaultValue: false, description: 'Skip local Gradle test execution prior to packaging')
        booleanParam(name: 'FORCE_DOCKER_NO_CACHE', defaultValue: false, description: 'Force Docker to rebuild runtime layers from scratch on Windows host')
    }

    environment {
        DOPPLER_TOKEN   = credentials('doppler-personal-token')
        DOPPLER_PROJECT = 'sec-pipeline'
        DOPPLER_CONFIG  = 'prd'
        SSH_CREDS_ID    = 'windows-laptop-ssh'
        IMAGE_BASE_NAME = 'funds-import-job'
    }

    stages {
        stage('Fetch Secrets from Doppler Cloud') {
            steps {
                script {
                    def response = sh(
                        script: '''
                            curl -s --request GET \
                              --url "https://api.doppler.com/v3/configs/config/secrets/download?project=${DOPPLER_PROJECT}&config=${DOPPLER_CONFIG}&format=json" \
                              --header "accept: application/json" \
                              --header "authorization: Bearer ${DOPPLER_TOKEN}"
                        ''',
                        returnStdout: true
                    ).trim()

                    def secrets = readJSON text: response
                    env.WINDOWS_HOST = secrets.WINDOWS_HOST
                    env.WINDOWS_USER = secrets.WINDOWS_USER
                    echo "Target Windows deployment host: ${env.WINDOWS_HOST}"
                }
            }
        }

        stage('Checkout & Commit Resolution') {
            steps {
                checkout scm
                script {
                    env.GIT_COMMIT_SHORT = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()
                    echo "Building and packaging commit: ${env.GIT_COMMIT_SHORT}"
                }
            }
        }

        stage('Compile, Test & Assemble Boot JAR') {
            steps {
                script {
                    def gradleCmd = params.SKIP_TESTS ? './gradlew clean bootJar -x test --no-daemon' : './gradlew clean test bootJar --no-daemon'
                    sh """
                        chmod +x ./gradlew
                        ${gradleCmd}
                    """
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'build/test-results/test/*.xml'
                }
            }
        }

        stage('Stream Context & Build Docker Image on Windows') {
            steps {
                script {
                    def noCacheFlag = params.FORCE_DOCKER_NO_CACHE ? "--no-cache" : ""
                    withCredentials([sshUserPrivateKey(credentialsId: env.SSH_CREDS_ID, keyFileVariable: 'SSH_KEY')]) {
                        sh """
                            tar -czf - Dockerfile build/libs | ssh -i "\$SSH_KEY" \
                                -o StrictHostKeyChecking=no \
                                -o ConnectTimeout=15 \
                                ${WINDOWS_USER}@${WINDOWS_HOST} \
                                "docker build ${noCacheFlag} --progress=plain \
                                    -t ${IMAGE_BASE_NAME}:latest \
                                    -t ${IMAGE_BASE_NAME}:${env.GIT_COMMIT_SHORT} -"
                        """
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo "Successfully built and tagged ${IMAGE_BASE_NAME}:latest on ${env.WINDOWS_HOST}"
        }
        failure {
            echo "funds-import-job deployment pipeline failed. Check console output above."
        }
    }
}